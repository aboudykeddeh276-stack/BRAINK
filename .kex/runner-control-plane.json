{
  "schema": "kex.github-runner-control-plane.v6",
  "cascade_order": [
    "MOUNT",
    "VERIFY_ALL",
    "HYDRATE_INDEXEDDB",
    "RESOLVE_KEX_URI",
    "PROJECT_UI",
    "RESOLVE_HOST_CONTROL",
    "ISSUE_HOST_CHALLENGE",
    "EXTERNAL_CARRIER_PROBE",
    "VERIFY_HOST_RESPONSE",
    "ADMIT_HOSTS",
    "NORMALIZE_NETWORK_INTENT",
    "PROJECT_NETWORK_LEDGERS",
    "SCHEDULE_CAPABILITY",
    "DISPATCH_TRIGGER",
    "MUTATE_STATE",
    "READBACK",
    "RECONCILE_HOST_STATE",
    "RECONCILE_NETWORK_STATE",
    "WRITEBACK",
    "PROOF_COMMIT",
    "REHYDRATE_ON_FAILURE"
  ],
  "warm_boot_order": [
    "VERIFY_SEED",
    "MOUNT_WORKBOOK_SUBSTRATE",
    "OPEN_INDEXEDDB_NAMESPACE",
    "HYDRATE_PULSES",
    "VERIFY_PROOFS",
    "MOUNT_OBJECTS",
    "SUBSCRIBE_UI_COMPONENTS",
    "MOUNT_HOST_CONTROL",
    "VERIFY_HOST_CONTROL_POLICY",
    "MOUNT_HOST_FABRIC",
    "MOUNT_IL_LLM_NETWORK_COMPILER",
    "LOAD_NETWORK_FUNCTION_REGISTRY",
    "MOUNT_KEDDEH_FABRIC_ACTUATOR",
    "ISSUE_HOST_CHALLENGE",
    "WAIT_EXTERNAL_CARRIER_PROBE",
    "VERIFY_HOST_RESPONSE",
    "ADMIT_LOCAL_HOST",
    "START_HOST_CONTROL_HEARTBEAT",
    "START_HOST_RECONCILER",
    "START_NETWORK_RECONCILER",
    "START_HEARTBEAT",
    "ENTER_REHYDRATE_LOOP"
  ],
  "acceptance_rule": [
    "VISIBLE_ACTION_HAS_TRIGGER",
    "TRIGGER_MUTATES_STATE",
    "MUTATION_READS_BACK",
    "MUTATION_WRITES_BACK",
    "WRITEBACK_APPENDS_PROOF",
    "PROOF_SUPPORTS_REHYDRATION",
    "HOST_STATE_EXPIRES_WHEN_HEARTBEAT_STALE",
    "EXTERNAL_MUTATIONS_REQUIRE_ONLINE_HOST",
    "HOST_READY_REQUIRES_EXTERNAL_CARRIER_PROBE",
    "CARRIER_PROCESS_LIVENESS_IS_NOT_CARRIER_USABILITY",
    "NETWORK_INTENT_NORMALIZED_ONCE",
    "NETWORK_PROJECTIONS_PRESERVE_CAUSAL_ID",
    "ADAPTER_CANNOT_REDEFINE_AUTHORITY",
    "NETWORK_PROMOTION_REQUIRES_OBSERVED_EVIDENCE",
    "HOST_LOCAL_NETWORK_PROOF_IS_NOT_EXTERNAL_REACHABILITY_PROOF",
    "GLOBAL_EDGE_REQUIRES_STANDARDS_QUALIFICATION"
  ],
  "host_control": {
    "integration_id": "BRAINK-DESKTOP-COMMANDER-R1",
    "route": "HOST_CONTROL",
    "bundle_manifest": "integrations/desktop_commander/BRAINK_DESKTOP_COMMANDER_BUNDLE_R1.json",
    "runtime": "runtime/host_control/braink_desktop_commander_runtime.py",
    "host_fabric": "runtime/host_control/braink_host_fabric.py",
    "activation_gate": "runtime/host_control/braink_host_activation.py",
    "external_probe": "runtime/host_control/braink_dc_remote_probe.py",
    "native_plugin": "NativeChatBot/Sources/BRAINKDesktopCommanderPlugin.swift",
    "mcp_config": "integrations/desktop_commander/MCP_CONFIG.example.json",
    "authority_required": true,
    "readback_required": true,
    "proof_required": true,
    "external_carrier_probe_required": true,
    "carrier_attestation_class": "OPERATIONAL_CORRELATION",
    "carrier_is_identity": false,
    "carrier_is_authority": false,
    "host_states": ["DISCOVERED", "IDENTIFIED", "AUTHORITY_VERIFIED", "HOST_READY", "STALE"],
    "host_modes": ["ONLINE", "OFFLINE_LOCAL"],
    "routing_law": "capability + authority + fresh observed host state",
    "offline_law": "local-only operations may continue; external mutations require ONLINE and fresh authority",
    "promotion_law": "process liveness cannot promote HOST_READY; a current externally executed carrier challenge response, capability readback, authority root and fresh heartbeat are mandatory"
  },
  "network_intent": {
    "runtime": "runtime/network/braink_network_intent.py",
    "model": "IL-LLM function-first registry + bounded observer-ledger projection",
    "normalization_law": "one producer request -> one causal_id -> one semantic_root -> many bounded ledger projections",
    "projection_ledgers": ["host", "network", "dns", "da", "registrar", "routing", "mesh", "uptime", "security", "iot", "identity", "authority", "proof"],
    "authority_law": "external network mutations fail closed when authority_root is UNBOUND",
    "transport_law": "Desktop Commander, DNS, registrar, FRR/BGP, mesh and future device adapters are carriers/executors and do not define semantic identity",
    "offline_law": "read/local operations may be compiled for ONLINE_OR_OFFLINE_LOCAL; outward mutations compile to ONLINE only"
  },
  "fabric_activation": {
    "actuator": "deploy/activate_keddeh_fabric.py",
    "transaction_order": [
      "REQUIRE_HOST_READY",
      "NORMALIZE_NETWORK_INTENT",
      "RESIDENT_NETWORK_VALIDATION",
      "HOST_NETWORK_ACTIVATION",
      "REQUIRE_DISTINCT_EXTERNAL_OBSERVER",
      "NETWORK_STACK_PROVEN_LIVE",
      "GLOBAL_EDGE_QUALIFICATION"
    ],
    "host_local_ceiling": "HOST_NETWORK_PROVEN",
    "external_promotion": "NETWORK_STACK_PROVEN_LIVE",
    "global_edge_promotion": "GLOBAL_EDGE_READY",
    "fail_closed": true
  },
  "teams": {
    "substrate": ["self-hosted", "kex", "substrate", "workbook", "python"],
    "cascade": ["self-hosted", "kex", "cascade", "hyperk0", "warmboot"],
    "api": ["self-hosted", "kex", "api", "fastapi", "openapi"],
    "object-runtime": ["self-hosted", "kex", "object-runtime", "ui-reflection", "telemetry"],
    "proof": ["self-hosted", "kex", "proof", "ledger", "rehydrate"],
    "stress": ["self-hosted", "kex", "stress", "telemetry", "performance"],
    "security": ["self-hosted", "kex", "security", "boundary", "audit", "rpki", "dnssec"],
    "deploy": ["self-hosted", "kex", "deploy", "docker", "release", "systemd"],
    "host-control": ["self-hosted", "kex", "host-control", "mcp", "desktop-commander", "remote", "linux", "macos", "scheduler", "reconciler", "external-proof"],
    "network": ["self-hosted", "kex", "il-llm", "network", "dns", "da", "registrar", "mesh", "bgp", "isp", "iot", "proof"]
  },
  "required_workflows": [
    ".github/workflows/kex-runtime-health.yml",
    ".github/workflows/kex-cascade-validation.yml",
    ".github/workflows/kex-workbook-substrate.yml",
    ".github/workflows/kex-openapi-validation.yml",
    ".github/workflows/kex-proof-ledger.yml",
    ".github/workflows/kex-object-runtime.yml",
    ".github/workflows/kex-stress-test.yml",
    ".github/workflows/kex-security-boundary.yml",
    ".github/workflows/kex-deploy.yml",
    ".github/workflows/braink-host-fabric.yml",
    ".github/workflows/braink-host-activation.yml"
  ]
}
