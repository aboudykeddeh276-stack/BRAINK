    "GLOBAL_EDGE_REQUIRES_STANDARDS_QUALIFICATION",
    "PUBLIC_UI_CANNOT_PROMOTE_RUNTIME_STATE",
    "PUBLIC_UI_READS_OBSERVED_STATE_ONLY",
    "LINGUISTIC_PROJECTION_CANNOT_MUTATE_NUMERIC_SOURCE",
    "ELEMENT_IDENTITY_IS_SEPARATE_FROM_PROPERTY_POLICY",
    "MEMORY_MODIFIER_CANNOT_REDEFINE_ELEMENT_IDENTITY",
    "UNREGISTERED_LINGUISTIC_RELATIONS_FAIL_CLOSED"
  ],
  "file_governance": {
    "manifest": "governance/file/BRAINK_FILE_GOVERNANCE_R1.json",
    "role": "GENETIC_SUBSTRATE_GOVERNANCE",
    "required_before_artifact_execution": true,
    "identity_law": "type + sector + role + version + trust + lifecycle + compatibility + bindings + proof",
    "execution_law": "artifact declaration is metadata; execution requires runner, capability, authority, readback and proof"
  },
  "linguistic_engine": {
    "runtime": "runtime/linguistics/braink_linguistic_engine.py",
    "specification": "governance/linguistics/BRAINK_LINGUISTIC_ENGINE_V1.md",
    "role": "IL_LLM_BOUNDED_LINGUISTIC_PROJECTION",
    "pipeline": "numeric state -> canonical atomic anchor -> typed property relation -> memory-array modifier -> English projection -> semantic root",
    "anchor_domain": "atomic numbers 1..118",
    "zero_policy": "FAIL_CLOSED_NO_ELEMENT",
    "property_policy": "VERSIONED_EXPLICIT_RELATION",
    "modifier_policy": "VERSIONED_MEMORY_ARRAY_RELATION",
    "source_mutation_allowed": false,
    "human_identity_required": false,
    "promotion_law": "English projection is derived observer state and never replaces producer numeric truth"
  },
  "public_surface": {
    "runtime": "runtime/public_gateway.py",
    "role": "PROJECTION_AND_BOUNDED_CONTROL",
    "routes": {
      "POST /braink/boot": "observed boot/readiness gate",
      "GET /mesh/ping": "backbone freshness projection",
      "GET /dashboards/summary": "host/runtime observed-state dashboard",
      "POST /chat/execute": "process-intent ingress with explicit actuator boundary"
    },
    "promotion_law": "HTTP success or UI button state never establishes HOST_READY, NETWORK_STACK_PROVEN_LIVE or GLOBAL_EDGE_READY",
    "human_identity_is_runtime_identity": false
  },
  "host_control": {
    "integration_id": "BRAINK-DESKTOP-COMMANDER-R1",
    "route": "HOST_CONTROL",
    "bundle_manifest": "integrations/desktop_commander/BRAINK_DESKTOP_COMMANDER_BUNDLE_R1.json",
    "runtime": "runtime/host_control/braink_desktop_commander_runtime.py",
    "host_fabric": "runtime/host_control/braink_host_fabric.py",
    "activation_gate": "runtime/host_control/braink_host_activation.py",
    "external_probe": "runtime/host_control/braink_dc_remote_probe.py",
    "native_plugin": "NativeChatBot/Sources/BRAINKDesktopCommanderPlugin.swift",
    "mcp_config": "integrations/desktop_commander/MCP_CONFIG.example.json",
    "authority_required": true,
    "readback_required": true,
    "proof_required": true,
    "external_carrier_probe_required": true,
    "carrier_attestation_class": "OPERATIONAL_CORRELATION",
    "carrier_is_identity": false,
    "carrier_is_authority": false,
    "host_states": ["DISCOVERED", "IDENTIFIED", "AUTHORITY_VERIFIED", "HOST_READY", "STALE"],
    "host_modes": ["ONLINE", "OFFLINE_LOCAL"],
    "routing_law": "capability + authority + fresh observed host state",
    "offline_law": "local-only operations may continue; external mutations require ONLINE and fresh authority",
    "promotion_law": "process liveness cannot promote HOST_READY; a current externally executed carrier challenge response, capability readback, authority root and fresh heartbeat are mandatory"
  },
  "network_intent": {
    "runtime": "runtime/network/braink_network_intent.py",
    "model": "IL-LLM function-first registry + bounded observer-ledger projection",
    "normalization_law": "one producer request -> one causal_id -> one semantic_root -> many bounded ledger projections",
    "projection_ledgers": ["host", "network", "dns", "da", "registrar", "routing", "mesh", "uptime", "security", "iot", "identity", "authority", "proof"],
    "authority_law": "external network mutations fail closed when authority_root is UNBOUND",
    "transport_law": "Desktop Commander, DNS, registrar, FRR/BGP, mesh and future device adapters are carriers/executors and do not define semantic identity",
    "offline_law": "read/local operations may be compiled for ONLINE_OR_OFFLINE_LOCAL; outward mutations compile to ONLINE only"
  },
  "fabric_activation": {
    "actuator": "deploy/activate_keddeh_fabric.py",
    "transaction_order": [
      "REQUIRE_HOST_READY",
      "NORMALIZE_NETWORK_INTENT",
      "RESIDENT_NETWORK_VALIDATION",
      "HOST_NETWORK_ACTIVATION",
      "REQUIRE_DISTINCT_EXTERNAL_OBSERVER",
      "NETWORK_STACK_PROVEN_LIVE",
      "GLOBAL_EDGE_QUALIFICATION"
    ],
    "host_local_ceiling": "HOST_NETWORK_PROVEN",
    "external_promotion": "NETWORK_STACK_PROVEN_LIVE",
    "global_edge_promotion": "GLOBAL_EDGE_READY",
    "fail_closed": true
  },
  "teams": {
