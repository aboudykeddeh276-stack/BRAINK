  "acceptance_rule": [
    "VISIBLE_ACTION_HAS_TRIGGER",
    "TRIGGER_MUTATES_STATE",
    "MUTATION_READS_BACK",
    "MUTATION_WRITES_BACK",
    "WRITEBACK_APPENDS_PROOF",
    "PROOF_SUPPORTS_REHYDRATION",
    "FILE_DECLARATION_DOES_NOT_EQUAL_EXECUTION",
    "FILE_TRUST_CANNOT_SILENTLY_INCREASE",
    "ADAPTER_CANNOT_REDEFINE_PRODUCER_TRUTH_OR_AUTHORITY",
    "HOST_STATE_EXPIRES_WHEN_HEARTBEAT_STALE",
    "EXTERNAL_MUTATIONS_REQUIRE_ONLINE_HOST",
    "HOST_READY_REQUIRES_EXTERNAL_CARRIER_PROBE",
    "CARRIER_PROCESS_LIVENESS_IS_NOT_CARRIER_USABILITY",
    "NETWORK_INTENT_NORMALIZED_ONCE",
    "NETWORK_PROJECTIONS_PRESERVE_CAUSAL_ID",
    "NETWORK_PROMOTION_REQUIRES_OBSERVED_EVIDENCE",
