      "capabilities": ["python", "openssl", "sqlite", "tcp-loopback", "udp-loopback", "process-spawn", "ephemeral-filesystem"],
      "availability_source": "workflow-job-readback"
    },
    {
      "executor_id": "local-container",
      "kind": "container",
      "capabilities": ["python", "tcp-loopback", "process-spawn", "isolated-filesystem"],
      "availability_source": "runtime-probe"
    },
    {
      "executor_id": "independent-remote-host",
      "kind": "independent-host",
      "capabilities": ["independent-host", "external-network-observer", "python", "tcp-public", "state-transfer"],
      "availability_source": "signed-remote-readback"
