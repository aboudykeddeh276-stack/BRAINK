{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braink.keddeh.systems/schema/research-claim.v1.json",
  "title": "BRAINK/KEX Research Claim",
  "type": "object",
  "required": [
    "claim_id",
    "title",
    "classification",
    "statement",
    "known_cs_adjacency",
    "invariants",
    "falsification",
    "proof_requirements",
    "required_evidence_level",
    "invalid_overclaims"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 3},
    "classification": {"type": "string", "minLength": 2},
    "statement": {"type": "string", "minLength": 10},
    "known_cs_adjacency": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "falsification": {
      "type": "object",
      "required": ["experiment", "pass_condition", "fail_condition"],
      "properties": {
        "experiment": {"type": "string"},
        "pass_condition": {"type": "string"},
        "fail_condition": {"type": "string"}
      },
      "additionalProperties": false
    },
    "proof_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proof_id", "description", "minimum_level"],
        "properties": {
          "proof_id": {"type": "string"},
          "description": {"type": "string"},
          "minimum_level": {"type": "integer", "minimum": 0, "maximum": 12},
          "required_executor_capabilities": {
            "type": "array",
            "items": {"type": "string"},
            "default": []
          }
        },
        "additionalProperties": false
      }
    },
    "required_evidence_level": {"type": "integer", "minimum": 0, "maximum": 12},
    "invalid_overclaims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "next_experiments": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  },
  "additionalProperties": false
}
