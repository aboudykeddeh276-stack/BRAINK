# BrAInK runtime example environment.
# Copy to a local .env and edit. NEVER put real secrets in a committed file.

# --- identity -------------------------------------------------------------
BRAINK_NAMESPACE=braink
BRAINK_VERSION=1.0.0
# Leave empty to have the runtime mint a random session id per process.
BRAINK_SESSION_ID=

# --- durability -----------------------------------------------------------
BRAINK_LEDGER_PATH=./braink_ledger.sqlite
BRAINK_STATE_PATH=./restart_state.json

# --- dns transport --------------------------------------------------------
BRAINK_DNS_RESOLVER=8.8.8.8
BRAINK_DNS_PORT=53
BRAINK_DNS_TIMEOUT=3.0
BRAINK_DNS_QUERY_NAME=braink.example
BRAINK_DNS_RECORD_TYPE=A
# Hard cap. Do not raise this: the sandbox cannot observe authoritative DNS.
BRAINK_DNS_STATUS_CAP=LOCALLY_EXECUTED

# --- signer ---------------------------------------------------------------
# "test" selects the published HMAC test key (LOCALLY_PROVEN).
# "production" selects the placeholder, which fails closed until a real key exists.
BRAINK_SIGNER_MODE=test
# Intentionally empty. Supply production key material at runtime only.
BRAINK_SIGNER_KEY=

# --- evidence -------------------------------------------------------------
BRAINK_EVIDENCE_DIR=./evidence
