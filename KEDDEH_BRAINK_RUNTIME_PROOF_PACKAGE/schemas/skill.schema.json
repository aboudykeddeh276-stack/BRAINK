{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://braink.local/schemas/skill.schema.json",
  "title": "BrAInK Skill Entry",
  "description": "A named capability provided by one or more components.",
  "type": "object",
  "required": ["skill_id", "skill_name", "namespace", "components", "status"],
  "additionalProperties": true,
  "properties": {
    "skill_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "skill_name": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Component names that jointly provide this skill."
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["DEFINED", "IMPLEMENTED", "UNIT_TESTED", "INTEGRATION_TESTED", "RESTART_TESTED", "LOCALLY_EXECUTED", "LOCALLY_PROVEN"]
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
