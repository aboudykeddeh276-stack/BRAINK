      "target_projection": ["legal issue", "matter chronology", "authority question", "remedy path", "deadline"],
      "preserved_invariants": ["claim identity", "policy version", "decision history", "evidence provenance", "uncertainty"],
      "target_added_semantics": ["jurisdiction", "procedure", "authority", "legal-review state"],
      "evidence_required": ["professional review where required", "authority references", "procedural receipt"]
    },
    {
      "id": "contract://keddeh/coms-claimpath/regulated-correspondence/v1",
      "source_owner": "umbrella://keddeh/coms",
      "target_owner": "umbrella://keddeh/claimpath",
      "source_objects": ["message", "participant", "channel", "delivery event", "acknowledgement", "retention state"],
      "target_projection": ["claim correspondence", "information request", "insurer response", "complaint communication"],
      "preserved_invariants": ["sender", "recipient", "time", "channel", "delivery evidence", "content fingerprint"],
      "target_added_semantics": ["claim event type", "response deadline", "evidence relevance"],
      "evidence_required": ["delivery receipt", "content hash", "retention policy"]
    },
    {
      "id": "contract://keddeh/spin-coms/service-runtime/v1",
