      "target_projection": ["claim requirement", "evidence request", "complaint package", "external dispute package"],
      "preserved_invariants": ["authority", "edition", "mandatory fields", "submission channel", "receipt"],
      "target_added_semantics": ["claim identity", "coverage issue", "loss item", "complaint state"],
      "evidence_required": ["authority source", "edition currency", "validation result", "submission readback"]
    },
    {
      "id": "contract://keddeh/claimpath-lawpath/dispute-escalation/v1",
