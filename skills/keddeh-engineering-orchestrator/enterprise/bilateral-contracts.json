      "target_owner": "umbrella://keddeh/coms",
      "source_objects": ["service", "workflow", "queue", "retry policy", "rate limit", "health state"],
      "target_projection": ["message delivery worker", "notification router", "correspondence gateway"],
      "preserved_invariants": ["idempotency", "ordering", "failure radius", "retry budget", "observability"],
      "target_added_semantics": ["communication channel", "consent", "delivery class", "retention"],
      "evidence_required": ["runtime receipt", "delivery receipt", "failure and recovery test"]
    },
    {
      "id": "contract://keddeh/keo-all/engineering-description/v1",
      "source_owner": "umbrella://keddeh/keo",
      "target_owner": "portfolio://keddeh/systems",
