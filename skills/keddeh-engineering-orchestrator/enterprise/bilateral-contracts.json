{
  "registry_id": "registry://keddeh/bilateral-contracts",
  "version": "1.0.0",
  "contract_rule": "A bilateral interface preserves the source owner's canonical identity and business meaning while allowing a target umbrella to consume or project the object through a declared adapter. Bilateral use is not hierarchy, merger, or semantic replacement.",
  "contracts": [
    {
      "id": "contract://keddeh/playwrite-formpath/document-filing/v1",
      "source_owner": "umbrella://keddeh/playwrite",
      "target_owner": "umbrella://keddeh/formpath",
      "source_objects": ["document", "section", "citation", "attachment"],
      "target_projection": ["filing narrative", "supporting document", "attachment manifest"],
      "preserved_invariants": ["source attribution", "version", "editorial state", "citation lineage"],
      "target_added_semantics": ["form edition", "field binding", "filing requirement", "submission state"],
      "evidence_required": ["source fingerprint", "transformation map", "filing package receipt"]
    },
    {
      "id": "contract://keddeh/formpath-claimpath/claim-document/v1",
      "source_owner": "umbrella://keddeh/formpath",
      "target_owner": "umbrella://keddeh/claimpath",
