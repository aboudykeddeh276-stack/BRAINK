# Keddeh BTC — Bitcoin Core production configuration (mainnet)
# Copy to your Bitcoin data directory as `bitcoin.conf` and edit the marked values.
#
# DOCTRINE: the JSON-RPC interface is PRIVATE. Bitcoin Core explicitly warns against
# exposing RPC to the public Internet (doc/JSON-RPC-interface.md). Only Bitcoin P2P
# (:8333) and, if you run remote workers, the Stratum service are ever public.

# ---- network ----
mainnet=1

# ---- Bitcoin P2P (may be public) ----
# Inbound P2P reachability is optional and safe; it carries no credentials.
listen=1
# port=8333            # default mainnet P2P port

# ---- JSON-RPC (PRIVATE — loopback only) ----
server=1
# Bind RPC to loopback ONLY. Do NOT add public interfaces here.
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
rpcport=8332

# ---- authentication ----
# Preferred: the auto-generated cookie file at <datadir>/.cookie (no secret in
# this file). The controller reads it via `--cookie <datadir>/.cookie`.
#
# Alternative: an rpcauth line generated by Bitcoin Core's share/rpcauth/rpcauth.py.
# If you use it, keep the credential OFF the worker network.
# rpcauth=CHANGE_ME:CHANGE_ME_SALT$CHANGE_ME_HMAC

# ---- wallet (PRIVATE) ----
# Load the payout wallet; wallet RPC stays scoped to /wallet/<name> and private.
# wallet=CHANGE_ME_WALLET_NAME

# ---- indexing (optional) ----
# txindex is not required for mining; enable only if you need it for other tooling.
# txindex=0

# ---- resource hygiene ----
dbcache=450
