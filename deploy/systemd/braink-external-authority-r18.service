[Unit]
Description=BRAINK External Authority Service R18
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=BRAINK_EXTERNAL_DOMAIN=keddeh.com
Environment=BRAINK_EXTERNAL_HOST=0.0.0.0
Environment=BRAINK_EXTERNAL_PORT=17942
ExecStart=/usr/bin/python3 /opt/braink/runtime/braink_external_authority_service_r18.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
