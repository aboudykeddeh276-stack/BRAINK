{
  "schema": "kex.virtual.hardware.contract.v1",
  "authority": "KEX/BRAINK",
  "purpose": "Define the hardware-shaped execution contract that a recursively derived virtual mesh space must satisfy before it may act as a virtual bare-metal carrier for another KEX mesh.",
  "governing_laws": {
    "physical_host_in_lineage": false,
    "virtual_machine_can_be_parent_carrier": true,
    "machine_template_is_invariant_generator": true,
    "virtual_machine_descriptors_share_template": true,
    "rehydration_preserves_kex_lineage": true,
    "rehydration_can_expand_materialisations": true,
    "random_target_selection_is_over_admissible_meshes": true,
    "entropy_decision_is_retained_in_route_receipt": true,
    "hardware_interface_equivalence_is_not_physical_performance_equivalence": true,
    "resident_payload_count_need_not_equal_virtual_machine_count": true
  },
  "machine_template_coordinate": "KEX://MACHINE-TEMPLATE/HYPERPROCESSOR-V1",
  "required_hardware_families": {
    "CPU": ["ISA", "REGISTER_FILE", "PRIVILEGE", "EXECUTION"],
    "MMU": ["ADDRESS_SPACE", "PAGE_TABLE", "TRANSLATION", "PROTECTION"],
    "MEMORY": ["RAM", "ROM", "NUMA_DESCRIPTOR", "SNAPSHOT"],
    "SYSTEM_BUS": ["MMIO", "PORT_IO", "ADDRESS_DECODE", "HOTPLUG"],
    "DMA_IOMMU": ["DMA", "IOMMU", "DEVICE_MEMORY_MAP"],
    "INTERRUPT": ["IRQ_CONTROLLER", "VECTOR_TABLE", "ROUTING"],
    "TIMER_CLOCK": ["MONOTONIC_CLOCK", "TIMER", "RTC", "WATCHDOG"],
    "NETWORK": ["VNIC", "QUEUE", "LINK_STATE", "ROUTE_BINDING"],
    "BLOCK": ["VBLOCK", "NAMESPACE", "SNAPSHOT", "JOURNAL"],
    "FIRMWARE": ["BOOT_ROM", "NVRAM", "DEVICE_TREE_OR_ACPI"],
    "BOOT": ["LOADER", "KERNEL_HANDOFF", "INIT_STATE"],
    "CONSOLE_DISPLAY": ["SERIAL", "FRAMEBUFFER", "INPUT"],
    "ACCELERATOR": ["VECTOR", "GPU_DESCRIPTOR", "OFFLOAD_CONTRACT"],
    "ENTROPY": ["RNG_INTERFACE", "ENTROPY_STATE"]
  },
  "rehydration_state_surface": [
    "cpu_state_ref",
    "memory_state_ref",
    "device_graph_ref",
    "interrupt_state_ref",
    "boot_state_ref",
    "network_state_ref",
    "storage_state_ref",
    "service_graph_ref",
    "route_lineage",
    "authority_state"
  ],
  "materialisation_states": [
    "VIRTUAL_BARE_METAL_ADDRESSABLE",
    "MATERIALISATION_REQUESTED",
    "MATERIALISED",
    "READBACK_VERIFIED",
    "MATERIALISATION_LOST",
    "REHYDRATED",
    "REJOINED"
  ],
  "random_rehydration_rule": {
    "eligibility": "deterministic capability/authority/state contract",
    "selection": "uniform random across current eligible virtual-machine-space population",
    "record": "candidate population size, selected index, selected coordinate, entropy source/observation",
    "replay": "recorded entropy observation reproduces the same selected route",
    "primary_secondary_semantics": false,
    "failback_required": false
  }
}
