  "logical_codebase_composition": {
    "rule": "Join codebases through proven identities, state contracts and typed relations; source-tree/repository merging is exceptional, not the integration primitive.",
    "required_match": ["identity_preserved","emits_accepts_compatibility","state_semantics_compatible_or_explicitly_adapted","authority_compatible","failure_semantics_known","proof_and_readback_available"],
    "decision": {"compatible":"CREATE_TYPED_KEX_BRIDGE","adaptable":"CREATE_EXPLICIT_ADAPTER_AND_TEST","incompatible":"KEEP_DISJOINT","unknown":"DO_NOT_FORCE_JOIN"}
  },
  "global_transition_view": ["ONLINE_GLOBAL_BINDING","IOT_GLOBAL_DEVICE_SPACE","WEB3_DISTRIBUTED_STATE_SPACE","WEB4_SEMANTIC_EXECUTION_SPACE","CLOUD_CARRIER_INDEPENDENCE","MESH_GLOBAL_CLOSURE"],
  "resolver_policy": "Inspect existing KEX capabilities, load the external observation ledger, compute ready predicates from dependency closure, bind only the relevant external boundary, independently read back the result, then recompute."
}
