  "trigger_terms": ["server","servers","node","host","hosting","domain","domain space","registrar","registry","DNS","nameserver","routing","router","route","bridge","gateway","API","API server","endpoint","listener","ingress","TLS","HTTPS","certificate","failover","rehydration","recovery","online","internet","IoT","device","sensor","actuator","Web3","Web4","cloud","mesh","peer","federation","WebSocket","QUIC","service discovery","load balancing","CDN","edge","codebase integration","repository integration","virtual machine","VM","bare metal","bare-metal","emulator","emulation","hyperprocessor","CPU","registers","MMU","memory bus","device bus","interrupt","firmware","boot","QEMU","KVM","HVF","nested virtualization","virtual hardware"],
  "canonical_capabilities": [
