  "governing_rules": {
    "discover_before_design": true,
    "local_conformance_is_inherent_admissibility": true,
    "local_conformance_is_transition_stage": false,
    "global_process_is_dependency_graph": true,
    "logical_composition_before_physical_merge": true,
    "source_repository_lineage_preserved": true,
    "host_provider_external_to_kex_lineage": true,
    "endpoint_digest_is_authority": false,
    "global_observed_requires_external_scope": true,
    "unknown_remains_unknown": true
  },
  "runtime": {
    "resolver": "tools/kex-capability-discovery/global-process-resolver.mjs",
    "observation_ledger": "tools/kex-capability-discovery/global-observation-ledger.seed.json",
    "state_machine": "tools/kex-capability-discovery/global-process-state-machine.v2.json",
    "execution_rule": "Resolve ready external predicates from dependency closure; do not advance a stage by label alone."
  },
  "trigger_terms": ["server","servers","node","host","hosting","domain","domain space","registrar","registry","DNS","nameserver","routing","router","route","bridge","gateway","API","API server","endpoint","listener","ingress","TLS","HTTPS","certificate","failover","recovery","online","internet","IoT","device","sensor","actuator","Web3","Web4","cloud","mesh","peer","federation","WebSocket","QUIC","service discovery","load balancing","CDN","edge","codebase integration","repository integration"],
  "canonical_capabilities": [
    {"id":"KEX-FUND-VIRTUAL-SERVICE-MESH-002","role":"recursive virtual service topology and KEX route-lineage proof"},
    {"id":"KEX-FUND-INFRA-DOMAIN-MESH-001","role":"server/domain/domain-space/registrar/DNS/hosting/routing/bridge/API/ingress/TLS/recovery specialization"},
    {"id":"KEX-BRAINK-INFRA-ROUTE-LINEAGE-001","role":"infrastructure topology and external promotion predicates"},
    {"id":"personal:kex-outbound-self-host-lease-loop","role":"external self-host bootstrap adapter; host remains carrier, not ancestor"},
    {"id":"personal:kex-domain-hosting-handoff","role":"registrar/DNS/TLS/HTTPS/domain authority adapter"},
    {"id":"personal:kex-self-host-domain-runtime-suite","role":"composed external bootstrap-to-domain runtime adapter"}
