      {"host":"kex.keddeh.com","public_binding_intended":true,"routes":[{"prefix":"/","methods":["GET","HEAD"],"coordinate":"KEX://DOMAIN-SPACE/keddeh/kex/site"},{"prefix":"/runtime","methods":["GET","POST"],"coordinate":"KEX://DOMAIN-SPACE/keddeh/kex/runtime"},{"prefix":"/proof","methods":["GET","POST"],"coordinate":"KEX://DOMAIN-SPACE/keddeh/kex/proof"},{"prefix":"/api","methods":["GET","POST"],"coordinate":"KEX://API/KEX/ROOT"}]},
