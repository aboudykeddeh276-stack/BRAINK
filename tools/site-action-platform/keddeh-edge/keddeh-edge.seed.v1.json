    "RECOVERY":{"accepts":["state.snapshot","server.receipt","proof.receipt"],"emits":["recovery.ready","runtime.command","recovery.receipt"]}
  },
  "illlm_semantic_derivations": [
    {"id":"EDGE_ROUTE_INGRESS","parents":["INGRESS","ROUTING"],"compatibility":[{"from":"INGRESS","token":"request.frame","to":"ROUTING"}],"function":"Convert a finite accepted ingress request into a typed KEX route selection without making the transport carrier part of lineage.","accepts":["transport.connection","tls.session","http.request"],"emits":["route.selection","ingress.route.receipt"]},
    {"id":"SECURE_EDGE_INGRESS","parents":["TLS","EDGE_ROUTE_INGRESS"],"compatibility":[{"from":"TLS","token":"tls.session","to":"EDGE_ROUTE_INGRESS"}],"function":"Bind verified hostname/TLS identity to the route-ingress decision while preserving TLS as a separately evidence-gated predicate.","accepts":["domain.identity","http.request"],"emits":["secure.route.selection","tls.route.receipt"]},
    {"id":"KEX_EDGE_LISTENER_RESOLVER","parents":["SECURE_EDGE_INGRESS","API_SERVER"],"compatibility":[{"from":"SECURE_EDGE_INGRESS","token":"secure.route.selection","to":"API_SERVER","to_alias":"route.selection"}],"function":"Demultiplex one finite edge ingress into a larger logical API/listener namespace through explicit KEX coordinates.","accepts":["domain.identity","http.request","service.coordinate"],"emits":["listener.dispatch","listener.resolve.receipt"]},
    {"id":"DOMAIN_AWARE_KEX_EDGE","parents":["DOMAIN_SPACE","KEX_EDGE_LISTENER_RESOLVER"],"compatibility":[{"from":"DOMAIN_SPACE","token":"service.coordinate","to":"KEX_EDGE_LISTENER_RESOLVER"}],"function":"Resolve public host/path intent into KEX domain-space/service coordinates before runtime dispatch.","accepts":["domain.name","http.request"],"emits":["listener.dispatch","service.coordinate","edge.resolve.receipt"]},
    {"id":"EXECUTABLE_KEDDEH_EDGE","parents":["DOMAIN_AWARE_KEX_EDGE","SERVER"],"compatibility":[{"from":"DOMAIN_AWARE_KEX_EDGE","token":"listener.dispatch","to":"SERVER"}],"function":"Materialise resolved KEX service coordinates on a finite execution carrier and return a typed response/readback receipt.","accepts":["domain.name","http.request","runtime.command"],"emits":["response.frame","server.receipt","edge.execution.receipt"]},
    {"id":"REHYDRATABLE_KEDDEH_EDGE","parents":["EXECUTABLE_KEDDEH_EDGE","RECOVERY"],"compatibility":[{"from":"EXECUTABLE_KEDDEH_EDGE","token":"server.receipt","to":"RECOVERY"}],"function":"Preserve edge identity and route semantics across restart or replacement carrier by replaying committed state and proving equivalent resolution.","accepts":["state.snapshot","domain.name","http.request"],"emits":["response.frame","recovery.ready","edge.rehydration.receipt"]}
  ],
  "finite_ingress": {"id":"KEX://EDGE/KEDDEH/V1/INGRESS/PUBLIC-HTTPS","public_ports":[443],"local_test_ports":[0],"protocols":["TLS","HTTP/1.1","HTTP/2","HTTP/3-ADAPTER-ELIGIBLE"],"public_tls_state":"EXTERNAL_EVIDENCE_REQUIRED","local_test_transport":"HTTP_LOOPBACK_ONLY"},
