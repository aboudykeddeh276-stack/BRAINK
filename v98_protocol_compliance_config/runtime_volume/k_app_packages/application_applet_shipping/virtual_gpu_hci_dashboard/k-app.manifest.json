{
  "applicationId": "kex.virtual.gpu.hci.dashboard",
  "boundary": "renders and visualizes state; does not promote pass state",
  "canonicalRuntimeRule": "DEPENDENCY_FAILURE_NE_GLOBAL_APPLICATION_FAILURE",
  "componentId": "virtual_gpu_hci_dashboard",
  "componentType": "APPLICATION",
  "dependencyPolicies": {
    "service.audio-output": "OPTIONAL",
    "service.native-gpu": "OPTIONAL",
    "service.remote-telemetry": "OPTIONAL",
    "service.runtime-config": "CORE_MANDATORY",
    "service.vfs": "CORE_MANDATORY",
    "service.virtual-gpu-hci-dashboard": "REPLACEABLE"
  },
  "deploymentMode": "MESH_REPLICATED",
  "entrypoint": "/index.html",
  "fallbackAdapters": {
    "service.audio-output": "adapter.visual-notification",
    "service.mesh-registry": "adapter.local-mesh-outbox",
    "service.native-gpu": "adapter.canvas-cpu-renderer",
    "service.remote-telemetry": "adapter.local-telemetry-outbox",
    "service.virtual-gpu-hci-dashboard": "adapter.canvas-cpu-renderer"
  },
  "optionalServices": [
    "service.audio-output",
    "service.native-gpu",
    "service.remote-telemetry"
  ],
  "ownerPlane": "virtual_gpu",
  "requiredServices": [
    "service.vfs",
    "service.runtime-config"
  ],
  "runtime": "BROWSER_ESM",
  "runtimeIndependenceContract": {
    "circuitBreakerLimits": {
      "failureThreshold": 2,
      "recoveryTimeoutSeconds": 60
    },
    "criticalityClass": "REPLACEABLE",
    "degradedModeBehaviour": "preserve core runtime and expose degraded capability state",
    "fallbackAdapter": "adapter.canvas-cpu-renderer",
    "identity": "virtual_gpu_hci_dashboard",
    "optionalDependencies": [
      "service.audio-output",
      "service.native-gpu",
      "service.remote-telemetry"
    ],
    "queueOutboxPolicy": "runtime_volume/outbox/application_applet_shipping/virtual_gpu_hci_dashboard",
    "recoveryConditions": [
      "dependency health check passes",
      "manifest integrity readback passes",
      "node capability readback passes"
    ],
    "reintegrationTests": [
      "tests/test_application_applet_packager.py",
      "tests/test_k_cloud_adapter.py"
    ],
    "rollbackContract": "retain previous package directory until new package receipt and integrity readback pass",
    "runtimeDependencies": [
      "service.virtual-gpu-hci-dashboard"
    ],
    "startupDependencies": [
      "service.vfs",
      "service.runtime-config"
    ],
    "suppliedCapabilities": [
      "virtual_gpu_hci_dashboard",
      "virtual_gpu"
    ]
  },
  "sourceSurface": "service_protocol_runtime_surface",
  "targetGates": [
    "AUTHORIZED_DOMAIN",
    "TLS_READBACK",
    "BROWSER_SECURITY",
    "WCAG",
    "MESH_NODE_READBACK"
  ],
  "version": "1.0.0"
}
