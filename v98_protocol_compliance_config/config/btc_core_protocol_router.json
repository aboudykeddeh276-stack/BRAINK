{
  "version": "V99",
  "router_id": "btc_core_protocol_router",
  "purpose": "Codeify the uploaded HEMOS Bitcoin Core interface into bounded executable P2P serialization, optional local JSON-RPC read-only calls, simulated market analysis, ledger readback and outbox handoff.",
  "source_boundary": "Derived from uploaded HEMOS Core Node Protocol and Network Integration Matrix V2026.8.2; unsafe or unsupported claims are converted to executable gates.",
  "service_contract": ["recognize", "execute", "verify", "write_receipt", "readback", "handoff"],
  "allowed_rpc_methods": ["getbestblockhash", "getblockchaininfo", "getblock"],
  "required_environment": ["BITCOIN_RPC_URL", "BITCOIN_RPC_USER", "BITCOIN_RPC_PASSWORD"],
  "default_mode": "bounded_local_router_without_private_key_generation_or_real_trade_execution",
  "network_ports": {"p2p_mainnet": 8333, "json_rpc_default": 8332},
  "promotion_rules": {
    "hardcoded_rpc_credentials_allowed": false,
    "plaintext_private_key_logging_allowed": false,
    "real_trade_execution_allowed": false,
    "hash_used_as_functional_proof": false,
    "target_host_bitcoind_required_for_live_rpc": true
  },
  "outputs": [
    "evidence/btc_core_protocol_router_receipt.json",
    "runtime_volume/btc_core_protocol_router.ledger",
    "runtime_volume/outbox/btc_core_protocol_router/*.handoff.json"
  ]
}
