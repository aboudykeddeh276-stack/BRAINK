{
  "version": "V99",
  "workflow_id": "software_design_deployment_workflow",
  "purpose": "Define and execute the standard software design-to-deployment lifecycle for the KEDDEH V98/V99 service spine, using small executable slices, typed gates, test-backed receipts, ledger readback and target-host/provider boundaries.",
  "completion_rule": [
    "source_code_exists",
    "executable_command_exists",
    "tests_executed",
    "receipt_written",
    "ledger_readback_verified",
    "outbox_handoff_written",
    "target_host_or_provider_receipt_where_required"
  ],
  "not_completion_by_itself": ["manifest", "telemetry", "hash", "report", "dashboard_render", "documentation"],
  "allowed_states": ["proposed", "ready", "in_progress", "blocked", "in_review", "ready_for_deployment", "deployed", "observed", "done", "cancelled"],
  "industry_references": [
    "ISO_IEC_IEEE_12207_2026",
    "NIST_SP_800_218_SSDF_1_1",
    "OWASP_SAMM",
    "DORA_CONTINUOUS_DELIVERY",
    "DORA_TRUNK_BASED_DEVELOPMENT",
    "GITHUB_ACTIONS_ENVIRONMENTS",
    "SLSA",
    "CycloneDX_ECMA_424",
    "OpenTelemetry"
  ],
  "phase_order": [
    "SDD-01-intake-and-work-identity",
    "SDD-02-architecture-and-boundary-design",
    "SDD-03-security-and-threat-model",
    "SDD-04-implementation-planning",
    "SDD-05-code-implementation",
    "SDD-06-verification-and-validation",
    "SDD-07-release-candidate-packaging",
    "SDD-08-deployment-gate",
    "SDD-09-target-host-deployment",
    "SDD-10-post-deployment-observability",
    "SDD-11-rollback-and-improvement"
  ],
  "phases": [
    {
      "phase_id": "SDD-01-intake-and-work-identity",
      "phase_type": "planning",
      "owner_service": "workflow_schema_guard",
      "state": "ready",
      "required_inputs": ["user_objective", "work_reference", "portable_slug", "human_title", "scope_level"],
      "activities": ["validate_work_item", "bind_branch_pr_commit_rules", "assign_owner_plane"],
      "required_outputs": ["validated_work_item", "workflow_schema_guard_receipt"],
      "required_receipts": ["evidence/workflow_schema_guard_receipt.json"],
      "standards": ["DORA_TRUNK_BASED_DEVELOPMENT", "GITHUB_ACTIONS_ENVIRONMENTS"],
      "promotion_gate": "LOCAL_PASS_ONLY_AFTER_SCHEMA_RECEIPT"
    },
    {
      "phase_id": "SDD-02-architecture-and-boundary-design",
      "phase_type": "design",
      "owner_service": "agent_registry_service",
      "state": "ready",
      "required_inputs": ["architecture_requirement", "authority_map", "service_protocols", "app_or_applet_boundary"],
      "activities": ["define_control_plane", "define_data_plane", "define_runtime_boundary", "define_vcpu_vgpu_separation"],
      "required_outputs": ["architecture_decision_record", "agent_registry_matrix"],
      "required_receipts": ["evidence/agent_registry_receipt.json"],
      "standards": ["ISO_IEC_IEEE_12207_2026", "NIST_SP_800_218_SSDF_1_1"],
      "promotion_gate": "ARCHITECTURE_BOUNDARY_RECEIPT_REQUIRED"
    },
    {
      "phase_id": "SDD-03-security-and-threat-model",
      "phase_type": "security_design",
      "owner_service": "secret_boundary_guard",
      "state": "ready",
      "required_inputs": ["data_flow", "trust_boundary", "secret_boundary", "provider_boundary"],
      "activities": ["identify_threats", "classify_secret_paths", "bind_provider_gates", "reject_plaintext_secrets"],
      "required_outputs": ["security_gate_matrix", "secret_boundary_receipt"],
      "required_receipts": ["evidence/service_probes_receipt.json"],
      "standards": ["NIST_SP_800_218_SSDF_1_1", "OWASP_SAMM"],
      "promotion_gate": "NO_SECRET_OR_PROVIDER_CLAIM_WITHOUT_RECEIPT"
    },
    {
      "phase_id": "SDD-04-implementation-planning",
      "phase_type": "engineering_plan",
      "owner_service": "task_milestone_monitor",
      "state": "ready",
      "required_inputs": ["phase_backlog", "worker_lane", "service_contract", "target_environment"],
      "activities": ["decompose_to_small_batches", "bind_50_100_milestones", "map_task_to_receipt"],
      "required_outputs": ["task_milestone_registry", "task_milestone_receipt"],
      "required_receipts": ["evidence/task_milestone_monitor_receipt.json"],
      "standards": ["DORA_CONTINUOUS_DELIVERY", "DORA_TRUNK_BASED_DEVELOPMENT"],
      "promotion_gate": "RECEIPT_BACKED_TASK_COUNT_ONLY"
    },
    {
      "phase_id": "SDD-05-code-implementation",
      "phase_type": "implementation",
      "owner_service": "agent_runtime_service",
      "state": "ready",
      "required_inputs": ["authorized_agent", "work_order", "service_binding", "source_path"],
      "activities": ["authorize_work_order", "execute_bounded_operation", "write_work_order_receipt"],
      "required_outputs": ["source_change", "agent_runtime_work_order_receipt"],
      "required_receipts": ["evidence/agent_runtime_work_order_*.json"],
      "standards": ["NIST_SP_800_218_SSDF_1_1", "DORA_CONTINUOUS_DELIVERY"],
      "promotion_gate": "AGENT_CANNOT_SELF_PROMOTE"
    },
    {
      "phase_id": "SDD-06-verification-and-validation",
      "phase_type": "verification",
      "owner_service": "test_runner",
      "state": "ready",
      "required_inputs": ["source_code", "tests", "negative_vectors", "expected_receipts"],
      "activities": ["compile_modules", "execute_all_test_functions", "execute_unittest_cases", "write_test_receipt"],
      "required_outputs": ["test_runner_receipt", "test_matrix"],
      "required_receipts": ["evidence/test_runner_receipt.json"],
      "standards": ["NIST_SP_800_218_SSDF_1_1", "OWASP_SAMM"],
      "promotion_gate": "TESTS_MUST_EXECUTE_NOT_JUST_EXIST"
    },
    {
      "phase_id": "SDD-07-release-candidate-packaging",
      "phase_type": "release_candidate",
      "owner_service": "vfs_volume_custody",
      "state": "ready",
      "required_inputs": ["version", "sbom_or_inventory", "release_notes", "artifact_manifest"],
      "activities": ["generate_inventory", "write_release_receipt", "append_ledger", "emit_outbox"],
      "required_outputs": ["release_candidate_receipt", "outbox_handoff"],
      "required_receipts": ["runtime_volume/proof_bundles.ledger"],
      "standards": ["CycloneDX_ECMA_424", "SLSA"],
      "promotion_gate": "ARTIFACT_CUSTODY_NOT_FUNCTIONAL_PROOF"
    },
    {
      "phase_id": "SDD-08-deployment-gate",
      "phase_type": "deployment_gate",
      "owner_service": "target_host_receipt_harness",
      "state": "ready",
      "required_inputs": ["target_host_profile", "runner_labels", "launchd_template", "provider_gate_matrix"],
      "activities": ["classify_local_target_provider_certification_gates", "require_m3_receipts", "fail_closed_when_required"],
      "required_outputs": ["target_host_receipts", "deployment_gate_matrix"],
      "required_receipts": ["evidence/target_host_receipts.json"],
      "standards": ["GITHUB_ACTIONS_ENVIRONMENTS", "DORA_CONTINUOUS_DELIVERY"],
      "promotion_gate": "TARGET_HOST_REQUIRED_UNTIL_M3_RUNNER_RECEIPT"
    },
    {
      "phase_id": "SDD-09-target-host-deployment",
      "phase_type": "deployment",
      "owner_service": "launchd_service_spine",
      "state": "ready",
      "required_inputs": ["self_hosted_macos_arm64_runner", "launchd_plist", "run_command", "environment_receipts"],
      "activities": ["checkout", "compile", "run_command", "load_launchd", "upload_artifacts"],
      "required_outputs": ["github_actions_artifact", "launchd_status_receipt"],
      "required_receipts": ["GitHub Actions artifact", "launchctl status receipt"],
      "standards": ["GITHUB_ACTIONS_ENVIRONMENTS", "DORA_CONTINUOUS_DELIVERY"],
      "promotion_gate": "DEPLOYED_ONLY_AFTER_HOST_ARTIFACT"
    },
    {
      "phase_id": "SDD-10-post-deployment-observability",
      "phase_type": "observability",
      "owner_service": "virtual_gpu_hci_dashboard",
      "state": "ready",
      "required_inputs": ["deployment_receipt", "runtime_logs", "metrics", "trace_events"],
      "activities": ["render_dashboard", "capture_logs_metrics_traces", "link_observability_to_receipts"],
      "required_outputs": ["dashboard_state", "observability_receipt"],
      "required_receipts": ["evidence/service_probes_receipt.json"],
      "standards": ["OpenTelemetry", "DORA_CONTINUOUS_DELIVERY"],
      "promotion_gate": "OBSERVABILITY_SUPPORTS_DIAGNOSIS_NOT_PROOF"
    },
    {
      "phase_id": "SDD-11-rollback-and-improvement",
      "phase_type": "continuous_improvement",
      "owner_service": "mirror_update_lane",
      "state": "ready",
      "required_inputs": ["incident_or_defect", "rollback_target", "learning_record", "next_work_item"],
      "activities": ["preserve_failure", "open_next_work_item", "mirror_learning", "update_standard"],
      "required_outputs": ["improvement_record", "mirror_update_lane_receipt"],
      "required_receipts": ["evidence/mirror_update_lane_receipt.json"],
      "standards": ["OWASP_SAMM", "DORA_CONTINUOUS_DELIVERY"],
      "promotion_gate": "FAILURES_PRESERVED_AND_REENTER_WORKFLOW"
    }
  ]
}
