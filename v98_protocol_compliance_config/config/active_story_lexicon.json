{
  "version": "V100-ACTIVE-STORY-1",
  "registryId": "keddeh.active-story.lexicon",
  "canonicalRule": "word identity is invariant; active meaning is contextually instantiated and source-linked",
  "words": [
    {"id":"word://observe","term":"OBSERVE","definition":"acquire a bounded state through a named observer and environment","invariants":["observer_required","environment_required","source_preserved"],"variants":["probe","heartbeat","measurement","projection"]},
    {"id":"word://identify","term":"IDENTIFY","definition":"resolve canonical identity without erasing source lineage","invariants":["canonical_identity_required","lineage_preserved"],"variants":["lexicon_lookup","node_identity","service_identity"]},
    {"id":"word://interpret","term":"INTERPRET","definition":"integrate observed characters into a contextual meaning without replacing their source definitions","invariants":["source_definitions_retained","context_declared"],"variants":["linguistic","protocol","service","sector"]},
    {"id":"word://traverse","term":"TRAVERSE","definition":"move between addressable contextual states using the declared topology","invariants":["source_state_preserved","destination_declared"],"variants":["wire","graph","workflow","mesh"]},
    {"id":"word://validate","term":"VALIDATE","definition":"apply declared rules and produce a reproducible result","invariants":["rule_declared","result_recorded","negative_path_defined"],"variants":["schema","integrity","protocol","semantic"]},
    {"id":"word://promote","term":"PROMOTE","definition":"advance only the capability supported by the available evidence","invariants":["evidence_required","rollback_retained","capability_scoped"],"variants":["local","host","provider","release"]},
    {"id":"word://preserve","term":"PRESERVE","definition":"retain source identity, context, operands, evidence and lineage across transition","invariants":["non_erasing","replayable"],"variants":["ledger","snapshot","receipt","backlink"]},
    {"id":"word://connect","term":"CONNECT","definition":"establish a bounded communication relation between named endpoints","invariants":["endpoints_declared","transport_declared","failure_policy_declared"],"variants":["tcp","p2p","service","mesh"]},
    {"id":"word://stream","term":"STREAM","definition":"maintain ordered transfer across an active channel with bounded buffering and backpressure","invariants":["ordering_defined","backpressure_defined","disconnect_handled"],"variants":["socket","event","telemetry","frame"]},
    {"id":"word://route","term":"ROUTE","definition":"select a permitted traversal path for a contextual payload","invariants":["source_declared","destination_declared","policy_resolved"],"variants":["network","task","application","market_observation"]},
    {"id":"word://verify","term":"VERIFY","definition":"read, compare, validate, record and produce evidence for a claim","invariants":["readback_required","comparison_required","receipt_required"],"variants":["manifest","p2p_header","heartbeat","ledger"]},
    {"id":"word://recover","term":"RECOVER","definition":"restore a bounded capability after its re-entry conditions are proven","invariants":["failure_preserved","reentry_tested","unaffected_domains_preserved"],"variants":["retry","fallback","deferred_commit","reintegration"]},
    {"id":"word://null-presence","term":"NULL_PRESENCE","definition":"dependent notation describing a character's null presence in a specified relation; the character remains preserved","invariants":["character_required","relation_required","observer_required","lineage_preserved"],"variants":["absence","null_membership","null_projection","null_resultant"]}
  ],
  "expressions": [
    {"id":"expression://verify-manifest-before-node-execution","words":[{"word":"word://verify","role":"predicate"},{"word":"word://preserve","role":"evidence_constraint"}],"sector":"sector://application-deployment","service":"service://k-cloud-admission","definition":"verify the immutable K-APP manifest through readback before allowing node-side execution","handler":"src/keddeh_k_cloud_adapter.py::KCloudAdapter.integrity_readback","requiredEvidence":["manifest_hash_expected","manifest_hash_actual","node_execution_allowed"]},
    {"id":"expression://connect-bitcoin-p2p-stream","words":[{"word":"word://connect","role":"predicate"},{"word":"word://stream","role":"transport"},{"word":"word://verify","role":"protocol_constraint"}],"sector":"sector://btc-protocol","service":"service://btc-node-observer","definition":"connect to a declared Bitcoin P2P endpoint, stream framed messages and verify header, command, length and checksum before recording observation","handler":"src/keddeh_btc_core_protocol_router.py","requiredEvidence":["endpoint","network_magic","command","payload_length","checksum_result","connection_state"]},
    {"id":"expression://reconcile-deferred-work","words":[{"word":"word://recover","role":"predicate"},{"word":"word://preserve","role":"lineage_constraint"}],"sector":"sector://runtime-continuity","service":"service://failure-ledger","definition":"reconcile deferred work only after dependency health and reintegration tests pass","handler":"src/keddeh_k_cloud_adapter.py::FailureLedger.reconcile_deferred_work","requiredEvidence":["failure_id","recovered_domain","reintegration_test","recovery_receipt"]},
    {"id":"expression://observe-node-health","words":[{"word":"word://observe","role":"predicate"},{"word":"word://validate","role":"freshness_constraint"}],"sector":"sector://mesh-infrastructure","service":"service://health-state-monitor","definition":"derive node health from a named observer, freshness window, capability dependencies and readback evidence","handler":"src/keddeh_k_cloud_adapter.py::HealthStateMonitor.observe","requiredEvidence":["node_id","observer","observed_at","freshness_limit","dependency_states"]}
