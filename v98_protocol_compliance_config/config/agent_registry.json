{
  "version": "V98",
  "registry_id": "keddeh_agent_registry",
  "purpose": "Declare, constrain, route, observe and audit all human, agent, service, virtual CPU, virtual GPU and VFS responsibilities without allowing manual or agent self-promotion.",
  "promotion_rules": {
    "human_may_define_agents": true,
    "human_may_edit_registry": true,
    "human_may_promote_pass": false,
    "agent_may_execute_assigned_work": true,
    "agent_may_promote_pass": false,
    "acceptance_harness_may_promote_local_pass": true,
    "telemetry_may_observe_not_promote": true,
    "virtual_gpu_may_render_not_promote": true
  },
  "required_agent_fields": [
    "agent_id",
    "agent_type",
    "owner_plane",
    "purpose",
    "allowed_actions",
    "denied_actions",
    "service_bindings",
    "inputs",
    "outputs",
    "telemetry_signals",
    "deployment_target",
    "promotion_authority"
  ],
  "agent_types": [
    {
      "agent_id": "architecture_owner",
      "agent_type": "human_authority",
      "owner_plane": "governance_plane",
      "purpose": "Define architecture, doctrine, acceptance meaning and business/user intent.",
      "allowed_actions": ["define_phi_psi", "approve_requirements", "request_changes", "review_receipts"],
      "denied_actions": ["promote_local_pass", "edit_ledger_history", "claim_provider_attestation_without_receipt"],
      "service_bindings": ["authority_map", "control_objectives", "agent_registry"],
      "inputs": ["user_request", "architecture_spec", "governance_constraint"],
      "outputs": ["requirements", "acceptance_meaning", "change_request"],
      "telemetry_signals": ["decision_event", "change_request_event"],
      "deployment_target": "repository_policy_and_review_surface",
      "promotion_authority": false
    },
    {
      "agent_id": "codex_implementation_agent",
      "agent_type": "coding_agent",
      "owner_plane": "implementation_plane",
      "purpose": "Edit repository files, create tests, implement service contracts and open pull requests.",
      "allowed_actions": ["edit_source", "write_tests", "create_pr", "repair_defects", "run_local_commands_when_available"],
      "denied_actions": ["self_certify", "promote_local_pass", "embed_plaintext_secrets", "claim_target_host_without_runner_receipt"],
      "service_bindings": ["agent_static_guard", "zero_heap_compiler", "orphan_service_reconciler"],
      "inputs": ["issue", "work_order", "repository_state"],
      "outputs": ["branch", "commit", "pull_request", "test_output"],
      "telemetry_signals": ["commit_event", "test_result", "defect_event"],
      "deployment_target": "github_branch_and_pull_request",
      "promotion_authority": false
    },
    {
      "agent_id": "acceptance_harness_agent",
      "agent_type": "mechanical_acceptance_agent",
      "owner_plane": "virtual_cpu",
      "purpose": "Execute deterministic acceptance, negative-space checks, ledger write/readback and outbox handoff.",
      "allowed_actions": ["execute_tests", "write_receipt", "readback_ledger", "emit_handoff", "promote_local_pass"],
      "denied_actions": ["edit_source", "claim_provider_attestation", "claim_external_certification"],
      "service_bindings": ["vfs_volume_custody", "peer_ack_verifier", "agent_registry_service"],
      "inputs": ["registry_config", "service_protocols", "standards_catalog"],
      "outputs": ["FINAL_VERIFICATION", "ledger_entry", "outbox_manifest", "registry_receipt"],
      "telemetry_signals": ["trace", "metric", "log", "receipt_event"],
      "deployment_target": "self_hosted_macos_arm64_runner",
      "promotion_authority": true
    },
    {
      "agent_id": "virtual_cpu_executor",
      "agent_type": "runtime_execution_plane",
      "owner_plane": "virtual_cpu",
      "purpose": "Run validation, service transitions, static scans, peer verification and volume custody operations.",
      "allowed_actions": ["run_state_transition", "execute_service_contract", "validate_input", "write_ledger", "readback_ledger"],
      "denied_actions": ["render_as_proof", "change_governance_policy_without_commit"],
      "service_bindings": ["hyper_explicit_mesh_runtime", "hemos_family_of_five_runtime", "indefinite_network_runtime"],
      "inputs": ["service_request", "state_vector", "volume_path"],
      "outputs": ["state_transition", "service_receipt", "execution_trace"],
      "telemetry_signals": ["trace", "metric", "log"],
      "deployment_target": "python_runtime_on_target_host_or_ci",
      "promotion_authority": false
    },
    {
      "agent_id": "virtual_gpu_projection_agent",
      "agent_type": "hci_projection_agent",
      "owner_plane": "virtual_gpu",
      "purpose": "Render dashboards, telemetry surfaces, frame state and service graph projections for user inspection.",
      "allowed_actions": ["render_dashboard", "display_telemetry", "show_service_graph", "surface_receipts"],
      "denied_actions": ["promote_local_pass", "mutate_ledger", "substitute_ui_for_test_evidence"],
      "service_bindings": ["virtual_gpu_hci_dashboard"],
      "inputs": ["state_json", "ledger_summary", "telemetry_signal"],
      "outputs": ["dashboard", "frame_projection", "telemetry_view"],
      "telemetry_signals": ["render_event", "ui_interaction", "frame_state"],
      "deployment_target": "dashboard/index.html_and_future_native_ui",
      "promotion_authority": false
    },
    {
      "agent_id": "braink_family_of_five_council",
      "agent_type": "consensus_audit_agent_group",
      "owner_plane": "audit_plane",
      "purpose": "Run independent audit channels over drift, service integrity, ledger continuity, ingress routing and unresolved gates.",
      "allowed_actions": ["audit_drift", "compare_receipts", "flag_orphan", "classify_gate"],
      "denied_actions": ["self_promote", "delete_failed_state", "override_acceptance_harness"],
      "service_bindings": ["hemos_family_of_five_runtime", "orphan_service_reconciler"],
      "inputs": ["service_receipts", "runtime_state", "orphan_registry"],
      "outputs": ["consensus_receipt", "orphan_resolution", "gate_classification"],
      "telemetry_signals": ["audit_event", "drift_metric", "consensus_state"],
      "deployment_target": "acceptance_harness_and_runtime_volume",
      "promotion_authority": false
    }
  ],
  "real_world_abstractions": [
    "identity_registry",
    "capability_registry",
    "role_based_access_control",
    "attribute_based_access_control",
    "service_discovery",
    "task_routing_table",
    "control_plane",
    "data_plane",
    "event_sourcing",
    "append_only_audit_log",
    "observability_instrumentation",
    "finite_state_machine"
  ]
}
