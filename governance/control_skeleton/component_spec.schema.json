{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keddeh.systems/schema/braink-governance-component-spec-v1.json",
  "title": "BRAINK Governance Component Specification",
  "type": "object",
  "required": [
    "schema",
    "component_id",
    "classification",
    "repository",
    "sector",
    "authority",
    "interfaces",
    "dependencies",
    "proof_conditions",
    "promotion_states"
  ],
  "properties": {
    "schema": {"const": "kex.braink.governance-component-spec.v1"},
    "component_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string"},
    "classification": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "sector": {"type": "string", "minLength": 1},
    "source_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "substrate_boundary": {"type": "string"},
    "state_class": {"type": "string"},
    "persistence_class": {"type": "string"},
    "address_space": {"type": "string"},
    "communication_mechanisms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "virtualisation_type": {"type": "string"},
    "authority": {
      "type": "object",
      "required": ["owner", "mutation_authority"],
      "properties": {
        "owner": {"type": "string"},
        "mutation_authority": {"type": "string"},
        "external_authorities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "producer", "consumer"],
        "properties": {
          "name": {"type": "string"},
          "producer": {"type": "string"},
          "consumer": {"type": "string"},
          "contract": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "class"],
        "properties": {
          "target": {"type": "string"},
          "class": {"enum": ["PACKAGE_DEPENDENCY", "MODULE_DEPENDENCY", "REPOSITORY_DEPENDENCY", "RUNTIME_AUTHORITY_DEPENDENCY"]},
          "required": {"type": "boolean", "default": true}
        },
        "additionalProperties": true
      }
    },
    "proof_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rollback_requirements": {"type": "array", "items": {"type": "string"}},
    "promotion_states": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "invalid_claims": {"type": "array", "items": {"type": "string"}},
    "cross_platform": {
      "type": "object",
      "properties": {
        "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "platform_specific_adapters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "root": {"type": "string"},
        "receipt_schemas": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "administration": {
      "type": "object",
      "properties": {
        "operators": {"type": "array", "items": {"type": "string"}},
        "required_runbooks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
