    "unit": {"type":"object","required":["unit_id","kind","name","sector","owner","author","authority","purpose","runtime_boundary","proof_condition","platform_contract"],"properties":{"unit_id":{"type":"string","minLength":1},"kind":{"enum":["SECTOR","MODULE","FUNCTION","SERVICE","AGENT","DOMAIN","RUNTIME","WORKFLOW","CONTROL"]},"name":{"type":"string","minLength":1},"sector":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"author":{"type":"string","minLength":1},"authority":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"runtime_boundary":{"type":"string","minLength":1},"proof_condition":{"type":"string","minLength":1},"platform_contract":{"type":"array","minItems":1,"items":{"type":"string"}},"parent_unit_id":{"type":["string","null"]}},"additionalProperties":false},
    "governance":{"type":"object"},"controls":{"type":"object"},"artifacts":{"type":"object"},"created_at":{"type":"string"}
  },
  "additionalProperties": false
}
