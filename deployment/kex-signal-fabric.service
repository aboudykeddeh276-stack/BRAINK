[Unit]
Description=KEX Canonical Signal Propagation Fabric
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/braink
Environment=PYTHONUNBUFFERED=1
Environment=KEX_SIGNAL_HOST=127.0.0.1
Environment=KEX_SIGNAL_PORT=18033
Environment=KEX_SIGNAL_STATE_DIR=/var/lib/braink/signal-fabric
ExecStart=/usr/bin/python3 -m runtime.signal_service
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/braink/signal-fabric

[Install]
WantedBy=multi-user.target
