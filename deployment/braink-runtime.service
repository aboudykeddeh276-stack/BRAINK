[Unit]
Description=BRAINK R20 Runtime Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/braink
ExecStart=/usr/bin/python3 /opt/braink/deployment/braink_runtime_service.py --state /var/lib/braink/runtime_state.json --host 127.0.0.1 --port 8799
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/braink

[Install]
WantedBy=multi-user.target
